class Solution {
public:
    string countAndSay(int n) {
        string result = "1";

        for (int i = 1; i < n; i++) {
            string next = "";

            for (int j = 0; j < result.size();) {
                int count = 1;

                while (j + count < result.size() &&
                       result[j] == result[j + count]) {
                    count++;
                }

                next += to_string(count);
                next += result[j];

                j += count;
            }

            result = next;
        }

        return result;
    }
};

Explaination:

Start with "1" and count consecutive identical digits. Add the count followed by the digit to generate the next sequence, repeating until reaching n.
